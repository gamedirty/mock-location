<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      这个权限本身早就废弃、也不会被真正授予（android:protectionLevel=signature|development），
      但系统「开发者选项 → 选择模拟位置信息应用」的 AppPicker 就是按"是否声明了它"来筛选列表的，
      不声明的话应用根本不会出现在那个选择列表里。所以必须保留。
    -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions" />

    <!-- 地图选点：加载在线瓦片 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 模拟 fused provider 需要（Android 12+），另外“用真实位置”也要 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 后台持续模拟 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮微调按钮：在别的应用上面直接推位置 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MapPickerActivity"
            android:exported="false"
            android:label="@string/title_map_picker" />

        <service
            android:name=".MockService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
